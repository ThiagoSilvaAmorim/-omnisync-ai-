{
  "name": "novo-omnisync-ia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "npm --prefix backend run dev",
    "dev:all": "concurrently -n frontend,backend -c auto \"npm run dev\" \"npm run dev:backend\"",
