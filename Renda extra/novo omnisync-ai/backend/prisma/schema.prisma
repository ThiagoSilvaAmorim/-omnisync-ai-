generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id         Int     @id @default(autoincrement())
  nome       String
  sku        String  @unique
  categoria  String
  preco      Float
  estoque    Int
  minimo     Int     @default(0)
  status     String
  fornecedor String  @default("")
  movements StockMovement[]
}

model Order {
  id               String   @id
  cliente          String
  data             String
  total            Float
  itens            Int
  status           String
  // Fase 1 dropshipping: decomposição do lucro por pedido
  custoFornecedor  Float?   @default(0)
  taxaMarketplace  Float?   @default(0)
  frete            Float?   @default(0)
  lucro            Float?   @default(0)
  origem           String?  @default("manual")
}

model Customer {
  id            Int     @id @default(autoincrement())
  nome          String
  tipo          String  @default("pessoa")
  email         String  @unique
  telefone      String
  cidade        String
  segmento      String  @default("")
  totalPedidos  Int
  totalGasto    Float
  status        String
  ultimoContato String  @default("")
}

model PurchaseOrder {
  id            String   @id
  fornecedor    String
  data          String
  total         Float
  status        String   @default("aguardando_aprovacao")
  pedidoId      String?
  idExterno     String?  @unique
  aprovador     String?
  aprovadoEm    DateTime?
  motivo        String?
  rastreio      String?
  mlShipmentId  String?
  mlStatus      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt @default(now())
}

model NotaFiscal {
  id            Int      @id @default(autoincrement())
  numero        String   @unique
  tipo          String
  destinatario  String
  origem        String
  data          String
  valor         Float
  status        String
}

model Cupom {
  id        Int      @id @default(autoincrement())
  codigo    String   @unique
  tipo      String   @default("percentual")
  valor     Float
  validade  String   @default("")
  usos      Int      @default(0)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Evento {
  id             String   @id
  type           String
  timestamp      DateTime @default(now()) @db.Timestamptz(6)
  source_agent   String   @default("")
  entity_type    String   @default("system")
  entity_id      String?
  correlation_id String
  causation_id   String?
  severity       String   @default("info")
  payload        Json     @default("{}")
  metadata       Json     @default("{}")

  @@index([type])
  @@index([correlation_id])
  @@index([timestamp(sort: Desc)])
  @@map("Evento")
}

model Tarefa {
  id              String   @id
  agent_id        String   @default("")
  action          String   @default("")
  entity_type     String   @default("system")
  entity_id       String?
  payload         Json     @default("{}")
  priority        String   @default("normal")
  status          String   @default("pending")
  attempts        Int      @default(0)
  max_retries     Int      @default(3)
  idempotency_key String?  @unique
  correlation_id  String?
  causation_id    String?
  result          Json?
  error           String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([status])
  @@index([agent_id])
  @@map("Tarefa")
}

model ProvedorChave {
  id        Int      @id @default(autoincrement())
  provedor  String
  rotulo    String   @default("")
  segredo   String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([provedor])
  @@map("ProvedorChave")
}

model ContaIntegracao {
  id        Int      @id @default(autoincrement())
  provedor  String
  empresaId Int
  // Identidade do seller para futura operação multi-loja.
  // O vínculo único continua (provedor, empresaId) até a migração
  // dedicada; segunda loja hoje atualizaria a mesma linha.
  mlUserId  String?
  rotulo    String   @default("")
  segredo   String   @default("")
  metadados Json     @default("{}")
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Multi-loja: uma linha por (provedor, empresa, seller).
  // Segunda loja cria nova linha em vez de sobrescrever a primeira.
  @@unique([provedor, empresaId, mlUserId])
  @@map("ContaIntegracao")
}

model StockMovement {
  id          Int      @id @default(autoincrement())
  productId   Int
  product     Product  @relation(fields: [productId], references: [id])
  type        String   // 'entrada' | 'saida' | 'ajuste'
  quantity    Int
  reason      String?
  createdAt   DateTime @default(now())
}

model Fornecedor {
  id                   Int      @id @default(autoincrement())
  empresaId            Int
  externalId           String?
  nome                 String
  endereco             String?
  telefone             String?
  site                 String?
  avaliacao            Float?
  quantidadeAvaliacoes Int      @default(0)
  categoria            String?
  fonte                String   @default("Manual")
  verificado           Boolean  @default(false)
  favorito             Boolean  @default(false)
  arquivado            Boolean  @default(false)
  vendeAtacado         Boolean?
  aceitaRevenda        Boolean?
  possuiNotaFiscal     Boolean?
  possuiApi            Boolean?
  prazoInformado       String?
  custoNegociado       Float?
  observacao           String?
  // Histórico de verificações manuais (append-only; nunca inventado).
  historicoVerificacoes Json     @default("[]")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([empresaId])
  @@unique([empresaId, externalId])
  @@map("Fornecedor")
}

// Catálogo de fornecedores (busca pública sem chave externa).
// Legados OSM: osmId/lat/lng/endereco/telefone/fonte sustentam a importação
// POST /api/suppliers/import-osm; a busca em si usa só as colunas do catálogo.
model Supplier {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  slug               String   @unique
  logoUrl            String?  @map("logo_url")
  coverImages        String[] @default([]) @map("cover_images")
  uf                 String   @db.Char(2)
  city               String
  niche              String?
  siteUrl            String?  @map("site_url")
  productCount       Int      @default(0) @map("product_count")
  marketplaces       String[] @default([])
  acceptsDropshipping Boolean  @default(true) @map("accepts_dropshipping")
  createdAt          DateTime @default(now()) @map("created_at")
  osmId              String?  @unique @map("osm_id")
  lat                Float?
  lng                Float?
  endereco           String?
  telefone           String?
  fonte              String   @default("osm")

  products CatalogProduct[]

  @@index([uf])
  @@index([niche])
  @@map("suppliers")
}

// Produtos do catálogo de fornecedores (visão Produtos da tela /fornecedores).
// Não confundir com o model Product (estoque interno, tabela "Product").
model CatalogProduct {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId String   @map("supplier_id") @db.Uuid
  name       String
  imageUrl   String?  @map("image_url")
  costPrice  Float?   @map("cost_price")
  sku        String?
  niche      String?
  category   String?
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, sku])
  @@index([supplierId])
  @@index([niche])
  @@index([category])
  @@map("products")
}


model Negocio {
  id        Int      @id @default(autoincrement())
  titulo    String
  cliente   String   @default("")
  valor     Float    @default(0)
  estagio   String   @default("lead")
  data      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@index([estagio])
  @@map("Negocio")
}

model Problema {
  id         String   @id
  titulo     String
  descricao  String   @default("")
  categoria  String   @default("Operacional")
  prioridade String   @default("media")
  data       String   @default("")
  status     String   @default("aberto")
  historico  Json     @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt @default(now())

  @@index([status])
  @@map("Problema")
}

model Meta {
  id        Int      @id @default(autoincrement())
  nome      String
  meta      Float
  atual     Float    @default(0)
  tipo      String   @default("number")
  setor     String   @default("Geral")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@map("Meta")
}

